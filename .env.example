# Read by systemd's EnvironmentFile, NOT automatically by Python.
PRAWO_DATA_DIR=/var/lib/prawo-otwarte
PRAWO_ALLOW_ELI=1
# Enable only after inspecting the existing local Basal service and testing it.
PRAWO_BASAL_ENABLED=0
PRAWO_BASAL_URL=http://127.0.0.1:8766
PRAWO_BASAL_TIMEOUT=8
# Routing threshold only. NOT a calibrated probability of legal correctness.
PRAWO_BASAL_THRESHOLD=0.80
PRAWO_OFFICIAL_TIMEOUT=12
